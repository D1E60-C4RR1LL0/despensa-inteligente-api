    {
      "id": 12,
      "title": "Solicitudes por endpoint",
      "description": "Excluye Swagger, OpenAPI y rutas desconocidas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, route) (rate(http_requests_total{job=\"despensa-api\",route!~\"/openapi.json|/docs.*|/redoc|unmatched\"}[2m]))",
          "legendFormat": "{{method}} {{route}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Latencia P95",
      "description": "Latencia estimada del percentil 95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"despensa-api\",route!~\"/openapi.json|/docs.*|/redoc|unmatched\"}[2m])))",
          "legendFormat": "P95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "CPU por contenedor",
      "description": "100% equivale al uso de un nucleo de CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"inventory-e3\",container_label_com_docker_compose_service=~\"api|db|prometheus|grafana|cadvisor\"}[2m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Memoria por contenedor",
      "description": "Memoria de trabajo por servicio",
      "type": "timeseries",
      "datasource": {
