# Configuracion nueva del stack Compose; no corresponde al MySQL local existente.
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
API_PORT=8000
API_IMAGE=inventory-api:local

# Generar valores propios. Los ejemplos vacios impiden un arranque accidental.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET_KEY=

# Debe coincidir con usuario, password y base anteriores; el host de Compose es db.
# El helper scripts/init_compose_env.py genera todos los valores coherentemente.
COMPOSE_DATABASE_URL=
